# Copy this file to ".env" and fill in your real connection string.
# Never commit your real .env file to version control.

# Local MongoDB example:
# MONGODB_URI=mongodb://127.0.0.1:27017/daily_calendar

# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/daily_calendar?retryWrites=true&w=majority

MONGODB_URI=mongodb://127.0.0.1:27017/daily_calendar
PORT=3000
