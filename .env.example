# Local MongoDB (if you have MongoDB installed and running on your machine)
MONGODB_URI=mongodb://127.0.0.1:27017/expense_tracker

# OR use a free MongoDB Atlas cluster (recommended, no local install needed)
# Get this connection string from https://cloud.mongodb.com after creating a free cluster
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/expense_tracker

PORT=5000
